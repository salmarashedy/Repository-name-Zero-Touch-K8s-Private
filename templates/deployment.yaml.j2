apiVersion: apps/v1
kind: Deployment

metadata:
  name: {{ app_name }}-deployment
  namespace: {{ namespace }}

  labels:
    app: {{ app_name }}

spec:
  replicas: {{ replicas }}

  selector:
    matchLabels:
      app: {{ app_name }}

  template:
    metadata:
      labels:
        app: {{ app_name }}

    spec:
      imagePullSecrets:
        - name: private-registry-credentials

      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: DoNotSchedule

          labelSelector:
            matchLabels:
              app: {{ app_name }}

      containers:
        - name: {{ app_name }}
          image: {{ image }}
          imagePullPolicy: Always

          ports:
            - containerPort: {{ port }}

          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ memory_request }}

            limits:
              cpu: {{ cpu_limit }}
              memory: {{ memory_limit }}